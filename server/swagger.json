{
  "openapi": "3.0.0",
  "info": {
    "title": "BidRight AI Analyzer",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://767b04f35d07b7.lhr.life",
      "description": "Localhost.run Tunnel"
    }
  ],
  "paths": {
    "/api/analyze": {
      "post": {
        "summary": "Analyze RFP text",
        "operationId": "extract_insights_from_a_tender",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The raw text of the RFP to be analyzed."
                  }
                },
                "required": ["text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful analysis",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "analysis": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}