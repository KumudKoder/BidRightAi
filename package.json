{
  "name": "bidrightai",
  "version": "1.0.0",
  "description": "AI-powered RFP/Tender analysis platform using IBM watsonx",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix frontend",
    "dev:backend": "npm start --prefix server",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "npm start --prefix server"
  },
  "keywords": [
    "ai",
    "rfp",
    "ibm-watsonx",
    "tender-analysis"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
